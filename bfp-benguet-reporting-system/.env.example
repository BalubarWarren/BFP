# Database (SQLite - path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRY="24h"

# Node Environment
NODE_ENV="development"

# Application URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# "Sign in with Google" (optional — the login page just shows the password form without it).
# From Google Cloud Console > APIs & Services > Credentials > Create Credentials > OAuth client
# ID > Web application. Add both http://localhost:3000 and your production domain under
# "Authorized JavaScript origins" (no redirect URI needed for this flow). This is a public
# identifier, not a secret — safe to expose client-side, which is why it's NEXT_PUBLIC_.
# Google only fills in the email of an EXISTING account (see app/api/auth/google/route.js) — it
# never creates one and never logs anyone in by itself; the admin-set password is still required.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Email (Gmail SMTP, free) — the Gmail account notifications are sent from, plus a Google
# App Password for it (requires 2-Step Verification: https://myaccount.google.com/apppasswords)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
